generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Product {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  price       Float
  image       String?

  featured Boolean @default(false)

  category        String?
  discountPercent Int?    @default(0)

  ingredients ProductIngredient[]

  heroSlides HeroSlide[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
}

model ProductIngredient {
  id Int @id @default(autoincrement())

  title       String
  description String?
  image       String?

  productId Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Event {
  id Int @id @default(autoincrement())

  title       String
  description String

  location  String
  eventDate DateTime

  bannerImage String?
  bookingLink String?

  sponsorName String?
  sponsorLogo String?

  featured Boolean @default(false)

  heroSlides HeroSlide[]

  createdAt DateTime @default(now())
}

model Inquiry {
  id Int @id @default(autoincrement())

  name    String
  phone   String
  email   String?
  message String

  productId Int?
  eventId   Int?

  createdAt DateTime @default(now())
}

model Contact {
  id Int @id @default(autoincrement())

  name  String
  email String
  phone String?

  subject String?
  message String

  createdAt DateTime @default(now())
}

model Setting {
  id Int @id @default(1)

  siteName    String?
  companyName String?

  phone   String?
  email   String?
  address String?

  facebook  String?
  instagram String?
  youtube   String?

  logo    String?
  favicon String?

  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id Int @id @default(autoincrement())

  title    String
  subtitle String?

  image String?

  buttonText String?
  buttonLink String?

  slideType String @default("custom")

  productId Int?
  eventId   Int?

  product Product? @relation(fields: [productId], references: [id])
  event   Event?   @relation(fields: [eventId], references: [id])

  order    Int     @default(1)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model HomeContent {
  id Int @id @default(1)

  aboutTitle   String?
  aboutContent String?

  ctaTitle    String?
  ctaSubtitle String?

  updatedAt DateTime @updatedAt
}

model Gallery {
  id Int @id @default(autoincrement())

  title    String?
  category String?

  image String

  createdAt DateTime @default(now())
}

model Testimonial {
  id Int @id @default(autoincrement())

  name String

  company String?

  review String

  rating Int @default(5)

  image String?

  createdAt DateTime @default(now())
}

model Cart {
  id        Int    @id @default(autoincrement())
  sessionId String @unique

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique

  sessionId String?

  // =====================================================
  // CUSTOMER
  // =====================================================

  firstName String
  lastName  String

  email       String
  countryCode String
  phone       String

  // =====================================================
  // DELIVERY ADDRESS
  // =====================================================

  addressLine1 String
  addressLine2 String?

  city       String
  state      String?
  postalCode String
  country    String

  // =====================================================
  // BUSINESS DETAILS
  // =====================================================

  companyName String?
  vatNumber   String?

  // =====================================================
  // DELIVERY
  // =====================================================

  deliveryInstructions String?

  deliveryCharge Float @default(0)

  deliveryChargeRequired Boolean @default(false)

  // =====================================================
  // DELIVERY OPTION
  // =====================================================

  deliveryOption String @default("normal")

  // =====================================================
  // GDPR / DATA ACKNOWLEDGEMENT
  // =====================================================

  dataAcknowledgement Boolean @default(false)

  // =====================================================
  // ORDER DESCRIPTION - NEW FIELD
  // =====================================================

  orderDescription String? @db.VarChar(500)

  // =====================================================
  // ORDER ITEMS
  // =====================================================

  items OrderItem[]

  // =====================================================
  // AMOUNTS
  // =====================================================

  subtotal Float

  discount Float @default(0)

  total Float

  // =====================================================
  // ORDER STATUS
  // =====================================================

  status String @default("PENDING")

  paymentStatus String @default("PENDING")

  // =====================================================
  // PAYMENT
  // =====================================================

  paymentMethod String?

  // =====================================================
  // PAYMENT PROOF
  // =====================================================

  paymentProof String?

  paymentProofUploadedAt DateTime?

  // =====================================================
  // PAYPAL
  // Keep for future
  // =====================================================

  paypalOrderId   String?
  paypalCaptureId String?

  // =====================================================
  // ZOHO BOOKS
  // =====================================================

  zohoBooksId    String?
  zohoCustomerId String?
  zohoInvoiceId  String?
  zohoPaymentId  String?

  // =====================================================
  // TIMESTAMPS
  // =====================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  productTitle String
  price        Float
  quantity     Int

  createdAt DateTime @default(now())
}



model Document {
  id        Int      @id @default(autoincrement())
  title     String
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}