generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Product {
  id              Int      @id @default(autoincrement())
  title           String
  description     String
  price           Float
  image           String?

  category        String?
  discountPercent Int      @default(0)

  featured        Boolean  @default(false)

  createdAt       DateTime @default(now())
}
model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  location     String
  eventDate    DateTime
  bannerImage  String?

  bookingLink  String?
  sponsorName  String?
  sponsorLogo  String?

  featured     Boolean @default(false)

  createdAt    DateTime @default(now())
}

model Inquiry {
  id        Int      @id @default(autoincrement())

  name      String
  phone     String
  email     String?
  message   String

  productId Int?
  eventId   Int?

  createdAt DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())

  name      String
  email     String
  phone     String?

  subject   String?
  message   String

  createdAt DateTime @default(now())
}

model Setting {
  id Int @id @default(1)

  siteName    String?
  companyName String?

  phone       String?
  email       String?
  address     String?

  facebook    String?
  instagram   String?
  youtube     String?

  logo        String?
  favicon     String?

  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id          Int      @id @default(autoincrement())

  title       String
  subtitle    String?

  image       String

  buttonText  String?
  buttonLink  String?

  slideType   String   @default("custom")

  productId   Int?
  eventId     Int?

  order       Int      @default(1)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
}


model HomeContent {
  id Int @id @default(1)

  aboutTitle   String?
  aboutContent String?

  ctaTitle     String?
  ctaSubtitle  String?

  updatedAt    DateTime @updatedAt
}

model Gallery {
  id Int @id @default(autoincrement())

  title      String?
  category   String?

  image      String

  createdAt  DateTime @default(now())
}

model Testimonial {
  id Int @id @default(autoincrement())

  name       String

  company    String?

  review     String

  rating     Int      @default(5)

  image      String?

  createdAt  DateTime @default(now())
}